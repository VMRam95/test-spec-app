    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.19",
    "axe-playwright": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "happy-dom": "^18.0.1",
    "jest": "^30.0.5",
